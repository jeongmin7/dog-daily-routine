# 하루(dog-health-tracker) 환경변수 예시.
# 실제 값은 .env에 넣으세요 (.env는 gitignore됨, 절대 커밋 X).

# Neon Postgres 연결 문자열. 용도가 달라서 두 개가 필요하다.
#
#  DATABASE_URL — 앱 런타임. 풀링(-pooler) 주소.
#                 서버리스 함수가 요청마다 커넥션을 열어 Neon 한계에 부딪히는 걸 막는다.
#  DIRECT_URL   — 마이그레이션/introspect. 직접(non-pooled) 주소.
#                 pooler에선 prepared statement가 충돌해 migrate가 깨진다.
#
# 둘은 호스트만 다르다(직접 = pooler 주소에서 "-pooler"를 뺀 것). 자격증명·DB는 동일.
# ⚠️ prisma.config.ts가 두 값의 존재를 강제한다 — 하나라도 없으면 `prisma generate`가 실패하고,
#    Vercel은 빌드의 postinstall에서 generate를 돌리므로 모든 배포 환경에 둘 다 등록해야 한다.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# NextAuth(Auth.js) 세션 서명 키. 아래로 생성:
#   openssl rand -base64 32
AUTH_SECRET="여기에-openssl-rand-base64-32-결과"

# Vercel Blob(사진 일지 업로드). Vercel 프로젝트에 Blob 스토어를 연결하면
# production엔 자동 주입되고, 로컬은 토큰을 .env에 넣어야 한다.
#   생성: Vercel 대시보드 Storage → Blob, 또는 `vercel blob store add`
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Vercel AI Gateway (로컬 개발용; 프로덕션은 Vercel OIDC 자동)
AI_GATEWAY_API_KEY=""
